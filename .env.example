# ==============================================================================
# DANKLEY INVENTORY INTAKER UNIVERSAL APP - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local in intake-dashboard/ and configure for your store.
# NEVER COMMIT YOUR REAL .env OR API KEYS TO GITHUB!

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI CONFIGURATION (MANDATORY FOR EXTRACTION & JUDGE AI)
# ------------------------------------------------------------------------------
# Obtain your Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model used for manifest extraction and Master Judge synthesis
# Supported models: gemini-2.5-flash, gemini-2.5-pro, gemini-3.1-flash-lite
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# Optional: Separate location-specific Gemini keys if splitting billing between stores
# GEMINI_API_KEY_QUEENS=your_queens_key_here
# GEMINI_API_KEY_DUTCHIE=your_dutchie_location_key_here

# ------------------------------------------------------------------------------
# 2. GOOGLE CLOUD VISION OCR (OPTIONAL - AUTOMATIC FALLBACK TO GEMINI VISION)
# ------------------------------------------------------------------------------
# The pipeline automatically falls back to Gemini 2.5 Flash Vision OCR if Google Cloud
# Vision is not configured or unavailable. If you have a Google Cloud service account:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-project-id

# ------------------------------------------------------------------------------
# 3. DANKLEY MULTI-TENANT AUTHENTICATION (@dankley.com)
# ------------------------------------------------------------------------------
# Random 64-character secret string for signing Dankley operator session JWTs
JWT_SECRET=generate_a_secure_random_64_character_string_here
SESSION_EXPIRY=7d

# ------------------------------------------------------------------------------
# 4. DUTCHIE POS CONFIGURATION (FOR DUTCHIE DISPENSARY LOCATIONS)
# ------------------------------------------------------------------------------
# In Dutchie Backoffice: Integrations -> API Keys -> Create API Key with Inventory Write access
DUTCHIE_API_KEY=your_dutchie_api_key_here
DUTCHIE_LOCATION_ID=your_dutchie_dispensary_store_id
# Dutchie API endpoint (default is production https://api.dutchie.com)
DUTCHIE_API_URL=https://api.dutchie.com/v1

# ------------------------------------------------------------------------------
# 5. ALLEAVES POS CONFIGURATION (FOR ALLEAVES DISPENSARY LOCATIONS)
# ------------------------------------------------------------------------------
# Direct REST/GraphQL endpoint and dispensary credentials for Alleaves POS
ALLEAVES_API_URL=https://api.alleaves.com/v1
ALLEAVES_USERNAME=your_alleaves_dispensary_username
ALLEAVES_PASSWORD=your_alleaves_dispensary_password
ALLEAVES_STORE_ID=OCM-RETL-XX-XXXXXX-D1

# ------------------------------------------------------------------------------
# 6. APP SERVER & CLIENT NETWORKING
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 7. SUPABASE DATABASE / CLOUD STORAGE (OPTIONAL)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
